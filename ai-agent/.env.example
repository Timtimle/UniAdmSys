# =========================
# OpenAI
# =========================
OPENAI_API_KEY=
# Set this to a model available in your OpenAI API project.
OPENAI_MODEL=gpt-5.6-luna
OPENAI_REASONING_EFFORT=low
OPENAI_STORE_RESPONSES=true

# =========================
# Supabase
# =========================
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co

# Recommended for this backend/microservice.
# NEVER put this key in frontend code or commit it to Git.
SUPABASE_SECRET_KEY=sb_secret_xxx

# Optional public key. Useful for verifying user sessions / public-only access.
SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx

# Legacy fallback only. New projects should prefer SUPABASE_SECRET_KEY.
SUPABASE_SERVICE_ROLE_KEY=

SUPABASE_TIMEOUT_SECONDS=30
DEFAULT_ADMISSION_YEAR=2025

# =========================
# App
# =========================
APP_NAME=UniAdmSys AI Agent
APP_ENV=development
CORS_ORIGINS=http://localhost:3000,http://localhost:5173
MAX_TOOL_ROUNDS=8
OPENAI_TIMEOUT_SECONDS=60
OPENAI_MAX_RETRIES=2
HTTP_MAX_RETRIES=2

# Development/demo only:
# allows candidate_id to be supplied directly when no Supabase Auth token exists.
ALLOW_DEMO_CANDIDATE_ID=true
