# OpenAI
OPENAI_API_KEY=sk-your-key-here
OPENAI_MODEL=gpt-5.6-luna
OPENAI_REASONING_EFFORT=low
OPENAI_STORE_RESPONSES=true

# UniAdmSys backend
# Keep true while your teammates' backend is not ready.
USE_MOCK_BACKEND=true
BACKEND_BASE_URL=http://localhost:5000
BACKEND_SERVICE_TOKEN=
BACKEND_TIMEOUT_SECONDS=10

# Frontend origins allowed to call this service directly (if needed).
# Recommended production flow is Frontend -> UniAdmSys Backend -> AI Agent.
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

MAX_TOOL_ROUNDS=6
